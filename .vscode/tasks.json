{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build FEM",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build"
      ],
      "dependsOn": "Configure FEM",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Configure FEM",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Test FEM",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build",
        "--output-on-failure"
      ],
      "dependsOn": "Build FEM",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run model",
      "type": "shell",
      "command": "./bin/fem",
      "windows": {
        "command": ".\\bin\\fem.exe"
      },
      "args": [
        "${input:modelName}"
      ],
      "dependsOn": "Build FEM",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "modelName",
      "type": "promptString",
      "description": "models/ 内のモデル名",
      "default": "model_1"
    }
  ]
}
