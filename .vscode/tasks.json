			"args": [
				"-c",
				"import sys\nfn='output/model_7/tempa.dat001'\nbad=[]\ntotal=0\nwith open(fn,'r') as f:\n    for ln,l in enumerate(f,1):\n        s=l.rstrip('\\n')\n        # pad to multiple of 12\n        L=len(s)\n        # If line shorter than 12, skip\n        for i in range(0, L, 12):\n            chunk=s[i:i+12]\n            if not chunk.strip():\n                continue\n            total+=1\n            try:\n                float(chunk)\n            except Exception as e:\n                bad.append((ln,i+1,chunk))\nprint('file:',fn)\nprint('total_fields:',total)\nprint('bad_count:',len(bad))\nif bad:\n    print('first_bad:',bad[0])\n    for b in bad[:10]: print(b)\n"
